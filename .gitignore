# Secrets and local config
.env
*.pem
*.key
secrets/

# Database
#
# The -wal and -shm sidecars matter as much as the .db file and are easy to miss. SQLite in
# WAL mode writes real database pages into the write-ahead log, so a committed .db-wal can
# contain password hashes, camera ingest keys, and duress secrets even when the .db itself is
# ignored. This was a genuine finding in this repository: see docs/12-secrets-incident.md.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ML weights (large, and not ours to redistribute)
*.pt
*.onnx
weights/

# NEVER commit footage. Store CCTV is your employer's data and the customers' personal data.
# Research datasets have their own licences and are not ours to vendor into a repo.
data/
media/
*.mp4
*.avi
*.mkv
*.mov
clips/

# Local reports
reports/*.html
reports/*.csv

# Personal career notes. Kept locally, not published: a hiring manager reading your prepared
# answer to their own question makes the answer read as coached, and it names a current employer.
docs/08-cv-and-interview-framing.md

# OS / editor
.DS_Store
.idea/
.vscode/
