# Copy to .env and change every secret before any non-local use.
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# .env is gitignored. Never commit real secrets.

# ---------- Runtime ----------
SENTINEL_ENV=development
SENTINEL_DEBUG=true
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000

# ---------- Cryptographic material ----------
# Signs session tokens. The app refuses to start in non-debug mode if left at this value.
SENTINEL_SECRET_KEY=CHANGE_ME_dev_only_do_not_use_in_production

# Session lifetime. Short by design: these are shared shop-floor terminals.
SENTINEL_SESSION_TTL_MINUTES=45

# ---------- Database ----------
SENTINEL_DATABASE_URL=sqlite:///./sentinelfloor.db

# ---------- Detection policy ----------
# Score in [0,1] at which a prompt is shown to staff. Deliberately not 0.5:
# in loss prevention a false positive costs staff trust and customer dignity,
# so we bias toward precision. Tune with analytics/detection_quality.py.
SENTINEL_ALERT_THRESHOLD=0.72

# Score at which the duty manager is also notified.
SENTINEL_ESCALATE_THRESHOLD=0.88

# Suppress repeat alerts for the same track for this many seconds.
SENTINEL_ALERT_COOLDOWN_SECONDS=90

# Reject events whose timestamp is outside this window (replay protection).
SENTINEL_EVENT_CLOCK_SKEW_SECONDS=30

# ---------- Retention ----------
# Behavioural events are minimised, but still relate to identifiable people in context.
# Keep the window as short as operationally useful. See docs/04-dpia-privacy.md.
SENTINEL_EVENT_RETENTION_HOURS=72
SENTINEL_AUDIT_RETENTION_DAYS=365

# ---------- Duress subsystem ----------
# Silent-first is the default and is a deliberate safety decision:
# a loud public alarm escalates confrontation and endangers staff.
SENTINEL_DURESS_SILENT_FIRST=true

# Enables the store-wide public announcement path. Off by default.
SENTINEL_DURESS_ALLOW_PUBLIC_BROADCAST=false

# Rolling-code acceptance window for duress fobs, in counter steps.
SENTINEL_DURESS_COUNTER_WINDOW=32
